@startuml classDiagram
skinparam Linetype ortho
skinparam groupInheritance 2

note as N1
In this diagram we are showing the classes and their methods that are used in the Allergens Dietary Ictoria plugin.
and not any WordPress core classes or methods.
Likewise with Woocommerce.
end note

note as N2
The file called Allergens_Dietary_Ictoria is the main file for the plugin.
But contains 2 classes these must be separated in a later rendition of the plugin.
This to support the Single Responsibility Principle and maintain clean code.
end note

package "php"{

    class Allergens_Dietary_Ictoria_Filter{
        -{static} _instance : Allergens_Dietary_Ictoria_Filter
        +{static} instance() : Allergens_Dietary_Ictoria_Filter
        - __construct() : void
        +create_filter() : void
        +filter_query(query : String) : void
    }

    class Allergens_Dietary_Ictoria_Functions {
        +{static} load_textdomain() : void
        +{static} get_settings() : array
        +{static} get_options() : array
        +{static} load_style() : void
        +{static} load_admin_js() : void
        +{static} error_notice(level:string, message:string) : void
        +{static} default_options() : array
    }

    class Allergens_Dietary_Ictoria_Activator{
        -{static} counter : int
        +{static} activate() : void
        -{static} create_tables() : void
    }

    class Allergens_Dietary_Ictoria_Product_Settings{
        -{static} _instance : Allergens_Dietary_Ictoria_Product_Settings
        +{static} instance() : void
        + data_tab(product_data_tabs:array) : array
        + data_fields() : void
        + save_product_options(post_id:int) : void
    }

    class Allergens_Dietary_Ictoria_Products{
        -{static} _instance : Allergens_Dietary_Ictoria_Products
        + show_product_options() : void
        + render_html(data:array): string

    }

    class Allergens_Dietary_Ictoria_Wc_Integration_Settings{
        + init_form_fields() : void
        +generate_allergensdietary_htnl() : void
        +{static} plugin_action_links(links:array) : array
    }
    
    package "forms"{

        enum FormType{
            ALLERGENS
            LICENSE

            + match(formType:FormType) : boolean
        }

        interface I_Allergens_Dietary_Ictoria_Form{
            + showForm(allergenName:String) : void
            + submit(data:array) : void
            + sanitize(data:array) : array
        }

        class Allergens_Dietary_Ictoria_Allergens_Form{
            -{static} _instance : Allergens_Dietary_Ictoria_Allergens_Form
            -{static} formType : FormType
            -{static} formObject : I_Allergens_Dietary_Ictoria_Form
            - __construct() : void
            + {static} getInstance() : Allergens_Dietary_Ictoria_Allergens_Form
            + {static} setFormType(formType:FormType) : void
            + {static} getFormType() : FormType
            + showForm(allergenName:String) : void
        }

        class Allergens_Dietary_Ictoria_License_Form{
            + getInstance() : Allergens_Dietary_Ictoria_License_Form
            + setFormType(formType:FormType) : void
            + getFormType() : FormType
            + showForm(allergenName:String) : void
            - check_license_key(key:string) : boolean
        }

    }

    package "dashboard"{

        class Ictoria_Admin_Menu {
            - {static} _instance : Ictoria_Admin_Menu
            - {static} directories : array
            + {static} instance() : Ictoria_Admin_Menu
            - __construct() : void
            + {static} iam_style() : void
            + {static} iam_script() : void
            + {static} autoload(class_name : String) : void
        }

        abstract class IAM_Base_Page {
            - page_title : string
            - menu_title : string
            - capability : string
            - menu_slug : string
            - callback : callable
            - icon_url : string
            - position : int
            - sections : array
            - {static} instances : array
            + {static} instance() : IAM_Base_Page
            + __construct(page_title: string, menu_title: string, capability: string, menu_slug: string, callback: callable, icon_url: string, position: int)
            + register_menu() : void
            + register_settings() : void
            + render_page() : void
            + add_section(section: IAM_Base_Section) : void
            + validate_settings(input: mixed) : mixed
            # is_top_level() : bool
            # get_parent_slug() : string
        }

        abstract class IAM_Base_Section {
            - section_id : string
            - section_title : string
            - fields : array
            - {static} instances : array
            + {static} instance() : IAM_Base_Section
            + __construct(section_id: string, section_title: string)
            + register_section(menu_slug: string) : void
            + add_field(field_id: string, field_title: string, callback: callable, args: array) : void
            + section_callback() : void
        }

        class IAM_Menu_Ictoria_Dashboard {
            - __construct() : void
            + is_top_level() : bool
            + get_parent_slug() : string
        }

        class IAM_Menu_Ictoria_Dashboard_Welcome {
            - __construct() : void
            + example_field_callback(args: array) : void
        }

        class IAM_Menu_Ictoria_Dashboard_Another_One {
            - __construct() : void
            + example_field_callback(args: array) : void
        }

        class IAM_Menu_Settings {
            - __construct() : void
            + is_top_level() : bool
            + get_parent_slug() : string
        }

        class IAM_Menu_Settings_Welcome {
            - __construct() : void
            + field_callback(args: array) : void
        }

        class IAM_Menu_Settings_Another_One {
            - __construct() : void
            + field_callback(args: array) : void
        }

        IAM_Menu_Ictoria_Dashboard --|> IAM_Base_Page
        IAM_Menu_Ictoria_Dashboard_Welcome --|> IAM_Base_Section
        IAM_Menu_Ictoria_Dashboard_Another_One --|> IAM_Base_Section

        IAM_Menu_Settings --|> IAM_Base_Page
        IAM_Menu_Settings_Welcome --|> IAM_Base_Section
        IAM_Menu_Settings_Another_One --|> IAM_Base_Section

        Ictoria_Admin_Menu ..> IAM_Menu_Ictoria_Dashboard : "manages"
        Ictoria_Admin_Menu ..> IAM_Menu_Settings : "manages"
        IAM_Base_Page *-r-> IAM_Base_Section : "has"
    }
}

package Allergens_Dietary_Ictoria{
    class Allergens_Dietary_Ictoria_Startup{
        +{static} on_activation : void
